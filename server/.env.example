# ---- Server ----
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---- Database ----
# Multi-document transactions require a replica set. The bundled docker-compose
# starts a single-node replica set, which is enough for local development.
MONGO_URI=mongodb://127.0.0.1:27017/ledgerpay?replicaSet=rs0&directConnection=true

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---- Wallet policy ----
CURRENCY=INR
MIN_TRANSFER_MINOR=100
MAX_TRANSFER_MINOR=20000000
DAILY_TRANSFER_LIMIT_MINOR=50000000
TRANSFER_FEE_BPS=0
REVERSAL_WINDOW_MINUTES=60

# ---- Razorpay (optional; leave blank to run without online payments) ----
# Sign up free at https://dashboard.razorpay.com and stay in TEST MODE.
# Settings -> API Keys -> Generate Test Key
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Settings -> Webhooks -> Add New Webhook. The secret is a value YOU choose,
# and it is NOT the same as RAZORPAY_KEY_SECRET.
RAZORPAY_WEBHOOK_SECRET=

# Withdrawals. 'simulated' needs nothing and runs the full payout lifecycle
# locally. 'razorpayx' calls the real Payouts API and needs a RazorpayX
# account with completed business KYC.
PAYOUT_PROVIDER=simulated
RAZORPAYX_ACCOUNT_NUMBER=
SIMULATED_PAYOUT_DELAY_MS=6000
MIN_WITHDRAWAL_MINOR=10000
